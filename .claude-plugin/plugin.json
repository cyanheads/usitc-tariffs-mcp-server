{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "usitc-tariffs-mcp-server",
  "version": "0.1.2",
  "description": "Search USITC tariff schedules, inspect heading trees, and look up published duty rates via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/usitc-tariffs-mcp-server#readme",
  "repository": "https://github.com/cyanheads/usitc-tariffs-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "ai-agents", "ai-tools", "typescript", "bun", "stdio", "streamable-http", "cyanheads", "usitc", "htsus", "tariffs", "customs", "trade", "harmonized-tariff-schedule", "hts", "duty-rates"],
  "mcpServers": {
    "usitc-tariffs-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/usitc-tariffs-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
